<Window x:Class="deepseek_copilot.SidebarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:deepseek_copilot"
        mc:Ignorable="d"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Width="960">
    <Grid>
        <Border x:Name="MainBorder" CornerRadius="8,0,0,8" Background="#FFFFFF">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" Opacity="0.25" ShadowDepth="2" Direction="270"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="46"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Title Bar -->
                <Border x:Name="TitleBar" Grid.Row="0" Background="#FFFFFF" CornerRadius="8,0,0,0"
                        BorderThickness="0,0,0,1" BorderBrush="#12000000">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                                    Margin="14,0,0,0">
                            <Image x:Name="TitleIcon" Width="18" Height="18"/>
                            <TextBlock x:Name="TitleText" Text="加载中…" FontSize="13" FontWeight="SemiBold"
                                       Margin="8,0,0,0" Foreground="#1A1A2E"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <Border Grid.Column="1" x:Name="ModeSwitch" CornerRadius="9" Padding="2"
                                Background="#0F000000" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="ChatTab" CornerRadius="7" Padding="16,4" Cursor="Hand"
                                        Background="Transparent" BorderBrush="Transparent" BorderThickness="0"
                                        MouseLeftButtonUp="OnChatTabClick">
                                    <TextBlock x:Name="ChatTabText" Text="Chat" FontSize="12" FontWeight="SemiBold"/>
                                </Border>
                                <Border x:Name="AgentTab" CornerRadius="7" Padding="16,4" Cursor="Hand"
                                        Background="Transparent" BorderBrush="Transparent" BorderThickness="0"
                                        MouseLeftButtonUp="OnAgentTabClick">
                                    <TextBlock x:Name="AgentTabText" Text="Agent" FontSize="12" FontWeight="SemiBold"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right"
                                    VerticalAlignment="Center" Margin="0,0,10,0">
                            <Border x:Name="SettingsButton" Width="30" Height="30" CornerRadius="7"
                                    Background="Transparent" Cursor="Hand" MouseLeftButtonUp="OnSettingsClick"
                                    ToolTip="设置" VerticalAlignment="Center">
                                <TextBlock x:Name="SettingsButtonText" Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border x:Name="CloseButton" Width="30" Height="30" CornerRadius="7"
                                    Background="Transparent" Cursor="Hand" MouseLeftButtonUp="OnCloseClick"
                                    ToolTip="关闭" VerticalAlignment="Center" Margin="4,0,0,0">
                                <TextBlock x:Name="CloseButtonText" Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- WebView Container -->
                <Grid Grid.Row="1" x:Name="WebViewHost"/>
            </Grid>
        </Border>
    </Grid>
</Window>
