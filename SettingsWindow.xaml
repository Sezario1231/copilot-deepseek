<Window x:Class="deepseek_copilot.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:deepseek_copilot"
        mc:Ignorable="d"
        Title="DeepSeek Copilot 设置"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Width="400" Height="360"
        ShowInTaskbar="False"
        Topmost="True">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="侧边栏宽度" FontSize="14"
                   Foreground="#333" Margin="0,0,0,8"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Slider x:Name="WidthSlider" Grid.Column="0" Minimum="250" Maximum="800"
                    Value="450" TickFrequency="10" IsSnapToTickEnabled="True"
                    ValueChanged="OnWidthChanged"/>
            <TextBlock Grid.Column="1" Text="{Binding ElementName=WidthSlider, Path=Value, StringFormat={}{0:0}}"
                       VerticalAlignment="Center" Foreground="#333" FontSize="14"
                       Margin="12,0,0,0" Width="40"/>
        </Grid>

        <CheckBox x:Name="AutoStartCheck" Grid.Row="2" Content="开机自动启动"
                  FontSize="14" Foreground="#333" IsChecked="{Binding AutoStart}"
                  Margin="0,12,0,0"/>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="URL" FontSize="14" Foreground="#333"
                       VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="UrlBox" Grid.Column="1" Text="{Binding ChatUrl}"
                     FontSize="13" Foreground="#333"/>
        </Grid>

        <Grid Grid.Row="4" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding ElementName=DelaySlider, Path=Value, StringFormat=释放 WebView 资源等待: {0:0} 秒}"
                       FontSize="14" Foreground="#333" VerticalAlignment="Center"/>
            <Slider x:Name="DelaySlider" Grid.Column="1" Minimum="1" Maximum="60"
                    Value="5" TickFrequency="1" IsSnapToTickEnabled="True"
                    Width="100" Margin="8,0,0,0"/>
        </Grid>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="保存" Width="80" Height="32"
                    Background="#4F6BED" Foreground="White" BorderThickness="0"
                    Click="OnSaveClick" Cursor="Hand" Margin="0,0,8,0"/>
            <Button Content="取消" Width="80" Height="32"
                    Background="#EEE" Foreground="#333" BorderThickness="0"
                    Click="OnCancelClick" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
